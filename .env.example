# =============================================================================
# Secure Multi-Vendor E-Commerce Platform - Environment Configuration
# -----------------------------------------------------------------------------
# Cach dung:
#   1) Copy file nay thanh ".env"  (Copy-Item .env.example .env)
#   2) Chinh cac gia tri can thiet (nhat la SECRET_KEY khi len production)
#   3) Chay: python seed_data.py  ->  python run.py
#
# App tu dong doc ".env" khi khoi dong (python-dotenv). Bien moi truong thuc te
# (CI/Docker) se duoc uu tien hon gia tri trong file.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development

# --- Security / JWT ----------------------------------------------------------
# BAT BUOC doi khi production. Tao khoa: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=super-secret-anti-tamper-key-2026-secure-escrow
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ----------------------------------------------------------------
# SQLite mac dinh (file trong thu muc goc). Co the doi sang PostgreSQL.
DATABASE_URL=sqlite:///./ecommerce_escrow.db

# --- Public site config (tra ve qua /api/config) -----------------------------
SITE_NAME=Escrow Anti-Tamper E-Commerce
DEFAULT_LATITUDE=21.0285
DEFAULT_LONGITUDE=105.8542

# --- Bootstrap / seed --------------------------------------------------------
# Tai khoan Admin lay tu env (khong hardcode). Bat buoc doi khi production.
ADMIN_EMAIL=admin@ecommerce.vn
ADMIN_PASSWORD=
# true = tao du lieu mau (shop/san pham/don hang + tai khoan demo).
# production: dat false (chi tao admin).
SEED_DEMO_DATA=true

# --- Admin bootstrap ---------------------------------------------------------
# Giu false: tai khoan Admin phai duoc seed/tao ngoai luong dang ky cong khai.
ALLOW_ADMIN_SELF_REGISTER=false

# --- Password reset ----------------------------------------------------------
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Tra token reset trong response API (CHI dung cho dev/test). Production: false.
EXPOSE_RESET_TOKEN=true

# --- Brute-force protection --------------------------------------------------
ACCOUNT_MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900

# --- Uniform authentication errors (ASVS 6.3.8) ------------------------------
# true -> tai khoan bi khoa tra ve cung thong bao/HTTP code nhu sai thong tin.
AUTH_UNIFORM_ERRORS=true

# --- Breached / weak password screening (ASVS 6.2.4 / 6.2.12) ----------------
BREACH_CHECK_ENABLED=true
# HaveIBeenPwned Pwned Passwords (k-anonymity, mien phi, khong can API key).
HIBP_ENABLED=false
HIBP_API_URL=https://api.pwnedpasswords.com/range/
HIBP_TIMEOUT_SECONDS=4

# --- Security notification emails (ASVS 6.3.7) -------------------------------
# false -> thu duoc luu vao OUTBOX trong bo nho + ghi log (dev/test, khong can SMTP).
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@ecommerce.vn
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Captcha (mien phi, tu dong / invisible) --------------------------------
# CAPTCHA_PROVIDER: google | turnstile | mock
#   google    -> Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
#   turnstile -> Cloudflare Turnstile (https://dash.cloudflare.com/)
#   mock      -> token offline co dinh (dung cho test/demo, khong goi mang)
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=google
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_MIN_SCORE=0.5
CAPTCHA_MOCK_TOKEN=test-captcha-token
